# Server Configuration
PORT=5000
NODE_ENV=development

# Formspree Endpoint for storing form submissions and delivering emails
FORMSPREE_URL=https://formspree.io/f/moejgbov

# Resend Email Delivery API Key (Optional alternative)
# Obtain an API key from https://resend.com/api-keys
RESEND_API_KEY=

# Sender Email Address
# By default, Resend provides "onboarding@resend.dev" for testing without custom domain.
# Once your domain is verified on Resend, you can use e.g. "Expense Tracker <reports@yourdomain.com>"
SENDER_EMAIL=Expense Tracker <onboarding@resend.dev>

# Secret token used to protect report generation & cron trigger endpoints
CRON_SECRET=expense_tracker_secure_token_2026

# Supabase Persistent Cloud Storage (Optional - Local file database is used when empty)
# Get credentials from your Supabase Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
